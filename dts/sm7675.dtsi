// SPDX-License-Identifier: BSD-3-Clause
// Shared Qualcomm SM7675 (cliffs) resources, derived from the uke vendor_boot
// device tree and the Xiaomi kernel sources at 5712080a. Board peripherals,
// memory and reservations live in the device repository's dts/.
/ {
    compatible = "qcom,cliffs";
    #address-cells = <2>;
    #size-cells = <2>;
    interrupt-parent = <&gic>;

    cpus {
        #address-cells = <2>;
        #size-cells = <0>;
        timebase-frequency = <19200000>;
        cpu0: cpu@0 { device_type = "cpu"; compatible = "qcom,kryo"; reg = <0 0>; };
        cpu1: cpu@100 { device_type = "cpu"; compatible = "qcom,kryo"; reg = <0 0x100>; };
        cpu2: cpu@200 { device_type = "cpu"; compatible = "qcom,kryo"; reg = <0 0x200>; };
        cpu3: cpu@300 { device_type = "cpu"; compatible = "qcom,kryo"; reg = <0 0x300>; };
        cpu4: cpu@400 { device_type = "cpu"; compatible = "qcom,kryo"; reg = <0 0x400>; };
        cpu5: cpu@500 { device_type = "cpu"; compatible = "qcom,kryo"; reg = <0 0x500>; };
        cpu6: cpu@600 { device_type = "cpu"; compatible = "qcom,kryo"; reg = <0 0x600>; };
        cpu7: cpu@700 { device_type = "cpu"; compatible = "qcom,kryo"; reg = <0 0x700>; };
    };

    psci { compatible = "arm,psci-1.0"; method = "smc"; };

    soc {
        compatible = "simple-bus";
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        gic: interrupt-controller@17100000 {
            compatible = "arm,gic-v3";
            unixnu,adt-name = "intc";
            reg = <0 0x17100000 0 0x10000>, <0 0x17180000 0 0x200000>;
            #interrupt-cells = <4>;
            #address-cells = <0>;
            interrupt-controller;
            redistributor-stride = <0 0x40000>;
        };

        ufs: ufshc@1d84000 {
            compatible = "qcom,ufshc";
            unixnu,adt-name = "ufshc";
            reg = <0 0x1d84000 0 0x3000>;
            status = "disabled";
        };

        gpu: gpu@3d00000 {
            compatible = "qcom,adreno-gpu-gen7-11-0", "qcom,kgsl-3d0";
            reg = <0 0x3d00000 0 0x40000>;
            status = "disabled";
        };

        gmu: gmu@3d68000 {
            compatible = "qcom,gen7-gmu";
            reg = <0 0x3d68000 0 0x37000>, <0 0xb280000 0 0x10000>;
            reg-names = "gmu", "gmu_pdc";
            status = "disabled";
        };

        gpu_smmu: iommu@3da0000 {
            compatible = "qcom,adreno-smmu", "arm,mmu-500";
            reg = <0 0x3da0000 0 0x40000>;
            #iommu-cells = <2>;
            status = "disabled";
        };
    };
};
